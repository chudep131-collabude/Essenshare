# EssenShare Backend Environment Variables
# Copy to backend/.env and fill in real values.
# Never commit backend/.env to version control.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Supports local PostgreSQL or hosted providers (Neon, Supabase, etc.)
# For Neon: copy the connection string from your Neon dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/surplus_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your-strong-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-strong-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
# Create an API key and add a sending domain in the Resend dashboard
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
SMTP_FROM=noreply@yourdomain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
