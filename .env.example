# Global Surplus Redistribution Platform — Environment Variables
# Copy this file to backend/.env and fill in real values before starting the server.
# Never commit backend/.env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters in production
JWT_ACCESS_SECRET=replace-with-at-least-32-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/surplus_dev

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
