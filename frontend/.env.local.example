# EssenShare Frontend Environment Variables
# Copy to .env.local and fill in real values

# Backend API URL — must point to the running backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Map — Mapbox (optional but recommended for quality tiles)
# Get a free token at https://account.mapbox.com/access-tokens/
# Free tier: 50,000 map loads/month
# Leave blank to use OpenStreetMap tiles (no key needed, lower quality)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
